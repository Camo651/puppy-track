# Puppy Track configuration. Copy to .env and fill in. One file for the backend
# and the (same-origin) frontend. Only VITE_-prefixed vars would reach the
# browser bundle; none are required because the UI talks to the API same-origin.

# === Environment ===

# Environment label for this instance (e.g. local, production). Also acts as a
# fallback production toggle: if NODE_ENV is unset, setting this to "production"
# enables production behavior.
APP_ENV=local

# Node runtime environment. Set to "production" on the server to enable
# production behavior; leave as "development" when running locally.
NODE_ENV=development

# Port the single Express service listens on (it serves both the API and the
# built SPA).
PORT=8080

# === Public URLs ===

# Base URL the app is reached at; Discord OAuth redirects back here after login.
# Local dev: http://localhost:5173 (Vite proxies /api to the backend).
# Production: https://puppy.example.com
FRONTEND_URL=http://localhost:5173

# === Puppy ===

# Your puppy's name, shown throughout the app and in notifications.
PUPPY_NAME=

# Your puppy's birthday in yyyy-mm-dd format.
PUPPY_BIRTHDATE=

# === Discord OAuth (sign-in) ===

# Discord application's OAuth2 Client ID. Create an application at
# https://discord.com/developers/applications.
DISCORD_CLIENT_ID=1562560203008905227

# Discord application's OAuth2 Client Secret (keep this private).
DISCORD_CLIENT_SECRET=

# OAuth2 redirect URL; must exactly match a redirect registered on the Discord
# app (scope: identify).
# Local dev: http://localhost:5173/api/auth/discord/callback
# Production: https://puppy.example.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback

# Comma-separated Discord user IDs allowed to sign in (the allow-list / gate).
# Enable Developer Mode in Discord, right-click a user, "Copy User ID".
ALLOWED_DISCORD_IDS=

# === Web Push (VAPID) ===

# VAPID public key for Web Push notifications of predicted events. Generate a
# key pair once with: npx web-push generate-vapid-keys. Push requires HTTPS in
# production (localhost is exempt for dev), and on iOS the app must be installed
# to the Home Screen.
VAPID_PUBLIC_KEY=BCZ8l9tWaXJ7jO5j0CBItc-nUR-kprETIgoeLDgjSDpdqAWPs7-URUD7PSiC93IaDmN707iIoYIhxtEyR5Tge0A

# VAPID private key that pairs with VAPID_PUBLIC_KEY (keep this private).
VAPID_PRIVATE_KEY=GuFH-oxkgne-22af-XYDQdG8vtcfEPLnMeJKexGpdxU

# Contact URI sent with push messages, as a mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@puppy-track.local
